<Window x:Class="IntentInk.Desktop.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntentInk — Live Activity &amp; Diagnostics"
        Height="550" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="LogButton" TargetType="Button">
            <Setter Property="Background" Value="#1C2030"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D334A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3048"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Live Activity &amp; AI Diagnostics" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Monitors keystrokes, active applications, Ollama inference, and text replacements in real time." 
                           FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" 
                          Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Clear" Style="{StaticResource LogButton}" Click="BtnClear_Click" Margin="0,0,8,0"/>
                <Button Content="Copy All" Style="{StaticResource LogButton}" Click="BtnCopy_Click" Margin="0,0,8,0"/>
                <Button Content="Open Log File" Style="{StaticResource LogButton}" Click="BtnOpenFile_Click"/>
            </StackPanel>
        </Grid>

        <!-- Terminal Console Area -->
        <Border Grid.Row="1" Background="#06070B" BorderBrush="#1F2436" BorderThickness="1" CornerRadius="8" Padding="12">
            <RichTextBox x:Name="RtbLogs" Background="Transparent" Foreground="#CBD5E1"
                         BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Footer Legend -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Legend: " FontSize="11" Foreground="#64748B" Margin="0,0,8,0"/>
            <TextBlock Text="[INFO]" FontSize="11" Foreground="#38BDF8" Margin="0,0,12,0"/>
            <TextBlock Text="[SUCCESS]" FontSize="11" Foreground="#4ADE80" Margin="0,0,12,0"/>
            <TextBlock Text="[WARN]" FontSize="11" Foreground="#FBBF24" Margin="0,0,12,0"/>
            <TextBlock Text="[ERROR]" FontSize="11" Foreground="#F87171" Margin="0,0,12,0"/>
            <TextBlock Text="[AI]" FontSize="11" Foreground="#A78BFA"/>
        </StackPanel>
    </Grid>
</Window>
