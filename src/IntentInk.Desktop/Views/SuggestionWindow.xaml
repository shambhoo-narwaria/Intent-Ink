<Window x:Class="IntentInk.Desktop.Views.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntentInk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI, sans-serif"
        FontSize="12">

    <Window.Resources>
        <!-- Minimal Notepad++ / VS Accent Brushes -->
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#1177BB"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#202020"/>
        <SolidColorBrush x:Key="SubtleBorder" Color="#3C3C3C"/>

        <!-- Standard Button Style (Minimal Notepad++ Style) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4C4C4C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252525"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style (Replace) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource PrimaryAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0D5585"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252525"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="#DCDCDC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <!-- ======================================================== -->
        <!-- 1. COMPACT FLOATING BUTTON (Minimal Notepad++ Tooltip)   -->
        <!-- ======================================================== -->
        <Border x:Name="PillContainer"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="2"
                Height="28"
                Padding="8,0,10,0"
                Cursor="Hand"
                MouseLeftButtonUp="Pill_Click"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.4" ShadowDepth="1"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✦" FontSize="10.5" Foreground="#0E639C" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtPillLabel" Text="Fix Grammar" FontSize="11.5" FontWeight="SemiBold" 
                           Foreground="#DCDCDC" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. AI GENERATING / LOADING CARD (Minimal Notepad++ Style) -->
        <!-- ======================================================== -->
        <Border x:Name="LoadingContainer"
                Background="#202020"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="3"
                Width="360"
                Padding="14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.5" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <!-- Loading Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="11" Foreground="#0E639C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refining Text..." FontSize="12" FontWeight="SemiBold" Foreground="#DCDCDC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="18" Height="18" 
                            Background="Transparent" Foreground="#888888" BorderThickness="0"
                            Cursor="Hand" Click="BtnCancelLoading_Click" FontSize="11"/>
                </Grid>

                <!-- Clean Single Accent Progress Bar -->
                <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" 
                             Height="3"
                             Foreground="#0E639C" 
                             Background="#2A2A2A" 
                             BorderThickness="0"
                             Margin="0,0,0,10"/>

                <!-- Preview Area -->
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Border Height="8" Background="#2A2A2A" Margin="0,0,30,6" Opacity="0.8"/>
                        <Border Height="8" Background="#2A2A2A" Margin="0,0,70,0" Opacity="0.5"/>
                    </StackPanel>
                </Border>

                <!-- Timer / Status Details & Cancel Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Model: " FontSize="11" Foreground="#777777"/>
                        <TextBlock Text="llama3.2:3b" FontSize="11" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtLoadingTimer" Text="(0.0s)" FontSize="11" Foreground="#777777"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" 
                            Click="BtnCancelLoading_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. EXPANDED RESULT CARD (Minimal Notepad++ Editor Look)   -->
        <!-- ======================================================== -->
        <Border x:Name="ResultContainer"
                Background="#202020"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="3"
                Width="440"
                Padding="14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.55" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <!-- Card Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Badges -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="11" Foreground="#0E639C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="AI Grammar Fix" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                        <Border Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppBadge" Text="app" FontSize="10" Foreground="#888888"/>
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Content="✕" Width="18" Height="18" 
                            Background="Transparent" Foreground="#888888" BorderThickness="0"
                            Cursor="Hand" Click="BtnCancel_Click" FontSize="11"/>
                </Grid>

                <!-- View Switcher (Clean Paragraph vs Inline Diff) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnTabClean" Content="Corrected Paragraph" Style="{StaticResource TabButton}" 
                            Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3C3C3C" Click="BtnTabClean_Click"/>
                    <Button x:Name="BtnTabDiff" Content="Compare Changes" Style="{StaticResource TabButton}" 
                            Margin="4,0,0,0" Click="BtnTabDiff_Click"/>
                </StackPanel>

                <!-- Content Area: 1. Clean Text Box (Default) -->
                <Border x:Name="PanelCleanText" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="2" Padding="10" Margin="0,0,0,10" Visibility="Visible">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtCorrectedParagraph" 
                                 Background="Transparent" 
                                 Foreground="#D4D4D4" 
                                 BorderThickness="0" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 FontSize="13" 
                                 FontFamily="Consolas, Segoe UI, monospace"/>
                    </ScrollViewer>
                </Border>

                <!-- Content Area: 2. Diff RichText Box -->
                <Border x:Name="PanelDiffText" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="2" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <RichTextBox x:Name="RtbDiff" Background="Transparent" Foreground="#D4D4D4"
                                     BorderThickness="0" IsReadOnly="True" FontSize="13" 
                                     FontFamily="Consolas, Segoe UI, monospace"/>
                    </ScrollViewer>
                </Border>

                <!-- Status Feedback Label -->
                <TextBlock x:Name="TxtCardStatus" Text="" FontSize="11" Foreground="#888888" 
                           Margin="0,0,0,8" Visibility="Collapsed"/>

                <!-- Action Footer: Copy | Cancel | Replace -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Copy Button -->
                    <Button Grid.Column="0" Content="Copy" Style="{StaticResource SecondaryButton}" 
                            Click="BtnCopy_Click" ToolTip="Copy corrected text to clipboard"/>

                    <!-- Cancel Button -->
                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}" 
                            Margin="0,0,6,0" Click="BtnCancel_Click"/>

                    <!-- Replace Button -->
                    <Button Grid.Column="3" x:Name="BtnReplace" Content="Replace" 
                            Style="{StaticResource PrimaryActionButton}" Click="BtnReplace_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
